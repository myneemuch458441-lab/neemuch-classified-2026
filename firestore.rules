rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidProperty(data) {
      return data.keys().hasAll(['title', 'colony', 'config', 'contactNumber'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.colony is string && data.colony.size() > 0 && data.colony.size() <= 100
        && data.config is string && data.config.size() > 0 && data.config.size() <= 30
        && data.contactNumber is string && data.contactNumber.size() > 0 && data.contactNumber.size() <= 30;
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isValidProperty(request.resource.data);
      allow update: if isValidProperty(request.resource.data);
      allow delete: if true;
    }

    match /siteStats/{statId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
